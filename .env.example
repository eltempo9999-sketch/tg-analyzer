TG_ANALYZER_PORT=4600
TG_ANALYZER_SECRET=CHANGE_ME_generate_a_strong_random_secret

TELEGRAM_API_ID=<число из my.telegram.org>
TELEGRAM_API_HASH=<строка из my.telegram.org>

# LLM провайдер: anthropic | openrouter | gigachat | azureopenai
TG_LLM_PROVIDER=anthropic

# Anthropic (если TG_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenRouter (если TG_LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# GigaChat (если TG_LLM_PROVIDER=gigachat)
# GIGACHAT_AUTH_KEY=<base64 ClientId:ClientSecret>
# GIGACHAT_MODEL=GigaChat-Pro
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_INSECURE=1

# Azure OpenAI (если TG_LLM_PROVIDER=azureopenai)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01
