[Unit]
Description=Telegram Analysis Microservice
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/tg-analyzer
ExecStart=/root/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=15
EnvironmentFile=/etc/tg-analyzer/analyzer.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tg-analyzer

[Install]
WantedBy=multi-user.target
